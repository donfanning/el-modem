# Unified patches contain context prefixes before tabs and blank lines.
packaging/serial/*.patch -whitespace

# Preserve reviewed upstream notice bytes, including their trailing blank line.
packaging/third-party/*.LICENSE -text whitespace=-blank-at-eof

# Reviewed UMDF2 patch context and exact source-manifest license bytes.
packaging/windows-driver/*.patch text eol=lf -whitespace
packaging/windows-driver/LICENSE -text whitespace=-blank-at-eof
