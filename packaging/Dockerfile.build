# Use the same numerical runtime as the qualified original-DSP source image.
FROM debian:bookworm-slim
RUN apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
    python3 python3-venv python3-numpy python3-numba=0.56.4+dfsg-2 libopenblas0-pthread binutils \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv --system-site-packages /opt/el-modem-build \
    && /opt/el-modem-build/bin/pip install --no-cache-dir \
       pyinstaller==6.22.3 pyinstaller-hooks-contrib==2026.8 textual==0.89.1
RUN /opt/el-modem-build/bin/python -c \
    'import sys,numpy,numba,llvmlite; assert sys.version_info[:2] == (3,11); assert (numpy.__version__,numba.__version__,llvmlite.__version__) == ("1.24.2","0.56.4","0.39.1")'
ENV OPENBLAS_NUM_THREADS=1
WORKDIR /work
