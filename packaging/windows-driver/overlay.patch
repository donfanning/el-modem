+#define IOCTL_SERIAL_APPLY_DEFAULT_CONFIGURATION CTL_CODE(FILE_DEVICE_SERIAL_PORT, 40,METHOD_BUFFERED,FILE_ANY_ACCESS)
+
+//
+// Modem status bits, as reported through SERIAL_MSR_*.
+//
+#define SERIAL_MSR_DCD         0x01
+#define SERIAL_MSR_RLSD        0x01   /* alias for DCD; Windows uses RLSD in SERIAL_STATUS.Mask */
+#define SERIAL_MSR_CTS         0x02
+#define SERIAL_MSR_DSR         0x04
+#define SERIAL_MSR_RI          0x08
+#define SERIAL_MSR_DTR         0x10
+#define SERIAL_MSR_RTS         0x20
+#define SERIAL_MSR_LOOP        0x40
+#define SERIAL_MSR_CALL        0x80
+
+//
+// Layout copied verbatim from the WDK's ntddser.h. Getting this wrong is not
+// cosmetic: returning the wrong size makes the I/O manager reject the request
+// with ERROR_INVALID_USER_BUFFER (1784), which is exactly what ClearCommError
+// surfaced as before this was corrected.
+//
+typedef struct _SERIAL_STATUS {
+    ULONG Errors;
+    ULONG HoldReasons;
+    ULONG AmountInInQueue;
+    ULONG AmountInOutQueue;
+    BOOLEAN EofReceived;
+    BOOLEAN WaitForImmediate;
+    } SERIAL_STATUS,*PSERIAL_STATUS;
+
+typedef struct _SERIAL_STATS {
+    ULONG Errors[4];
+    ULONG BytesInTransmitBuffer;
+    ULONG BytesInReceiveBuffer;
+    ULONG ModemStatus;
+    } SERIAL_STATS,*PSERIAL_STATS;
+
+//
+// Modem status values as GetCommModemStatus() reports them.
+//
+// NOTE: these are a DIFFERENT bit domain from the SERIAL_MSR_* values above.
+// GetCommModemStatus() hands the driver's IOCTL result straight to the caller,
+// and callers decode it with the MS_*_ON constants from winbase.h. Returning
+// SERIAL_MSR_* here makes every application believe the line is dead - which is
+// exactly what happened before this was corrected (GetCommModemStatus returned
+// 0x07 and reported no carrier at all).
+//
+#ifndef MS_CTS_ON
+#define MS_CTS_ON           ((ULONG)0x0010)
+#define MS_DSR_ON           ((ULONG)0x0020)
+#define MS_RING_ON          ((ULONG)0x0040)
+#define MS_RLSD_ON          ((ULONG)0x0080)
+#endif
+
+//
+// PURGE_TXABORT / PURGE_RXABORT / PURGE_TXCLEAR / PURGE_RXCLEAR already come
+// from winbase.h via <windows.h>, so they are deliberately not redefined here.
+// (Their real mapping is TXABORT=0x1, RXABORT=0x2, TXCLEAR=0x4, RXCLEAR=0x8 -
+// note PURGE_TXCLEAR has no underscore.)
+//
+
+//
+// Layout copied verbatim from the WDK's ntddser.h. The caller sizes its buffer
+// from this exact struct, so returning anything larger is rejected with
+// ERROR_INSUFFICIENT_BUFFER (122).
+//
+typedef struct _SERIAL_COMMPROP {
+    USHORT PacketLength;
+    USHORT PacketVersion;
+    ULONG ServiceMask;
+    ULONG Reserved1;
+    ULONG MaxTxQueue;
+    ULONG MaxRxQueue;
+    ULONG MaxBaud;
+    ULONG ProvSubType;
+    ULONG ProvCapabilities;
+    ULONG SettableParams;
+    ULONG SettableBaud;
+    USHORT SettableData;
+    USHORT SettableStopParity;
+    ULONG CurrentTxQueue;
+    ULONG CurrentRxQueue;
+    ULONG ProvSpec1;
+    ULONG ProvSpec2;
+    WCHAR ProvChar[1];
+    } SERIAL_COMMPROP,*PSERIAL_COMMPROP;
+
 #endif  // #ifdef _KERNEL_MODE, #include <ntddser.h>
 
