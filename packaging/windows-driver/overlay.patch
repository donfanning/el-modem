@@ -0,0 +1,124 @@
+/*++
+
+Copyright (c) El-Modem Project
+
+Module Name:
+
+    broker.h
+
+Abstract:
+
+    Named-pipe transport for the virtual COM port.
+
+    The stock VirtualSerial sample answers AT commands internally and has no
+    way to reach a real modem. This broker gives the port a far end: bytes the
+    terminal writes are forwarded to a named pipe, and bytes arriving on that
+    pipe are handed back to the terminal.
+
+    It is strictly opt-in. Until El-Modem connects, the driver behaves exactly
+    as the sample did, so an unconnected port still answers AT locally.
+
+    One port owns one pipe. A port can be given a name of its own through its
+    device key, which is what lets several ports serve several El-Modem
+    instances at once.
+
+--*/
+
+#pragma once
+
+//
+// The pipe every port uses unless its own device key names another one.
+//
+#define ELMODEM_PIPE_DEFAULT  L"\\\\.\\pipe\\ElModemSerial"
+
+//
+// Per-port override, read from the port's own "Device Parameters" key. A REG_SZ
+// holding either a bare name ("ElModemSerial2") or a full pipe path. That key
+// belongs to a single device node, so two ports can name two pipes. El-Modem
+// must then be started with the matching --serial-device.
+//
+// Nothing sets this today; its absence is the normal single-port case.
+//
+#define ELMODEM_PIPE_VALUE    L"ElModemPipeName"
+
+//
+// Room for a resolved pipe name, terminator included.
+//
+#define ELMODEM_PIPE_NAME_CCH 128
+
+//
+// Room for the port's own name ("COM24"). The log is shared between ports, so
+// every line that matters says which port it came from.
+//
+#define ELMODEM_PORT_NAME_CCH 32
+
+//
+// Size of the staging buffer used in each direction. Kept small so the pump
+// stays responsive and back-pressure is visible to the caller.
+//
+#define BROKER_BUFFER_SIZE   512
+
+//
+// Pump interval. The thread uses PeekNamedPipe so it never blocks; this only
+// bounds how long a byte can sit waiting.
+//
+#define BROKER_POLL_MS       5
+
+//
+// QUEUE_CONTEXT is declared in queue.h, which internal.h includes first.
+//
+typedef struct _BROKER_CONTEXT {
+    PQUEUE_CONTEXT         QueueContext;
+    volatile LONG          Stop;
+    HANDLE                 Thread;
+    HANDLE                 Pipe;
+    WCHAR                  PipeName[ELMODEM_PIPE_NAME_CCH];
