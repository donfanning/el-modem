+VOID
+QueueServicePendingReads(
+    _In_ PQUEUE_CONTEXT QueueContext
+    )
+{
+    for (;;) {
+        WDFREQUEST request = NULL;
+        NTSTATUS   status;
+        size_t     available = 0;
+        size_t     copied = 0;
+
+        status = WdfIoQueueRetrieveNextRequest(QueueContext->ReadQueue, &request);
+        if (!NT_SUCCESS(status)) {
+            break;
+        }
+
+        RingBufferGetAvailableData(&QueueContext->RingBuffer, &available);
+
+        if (available > 0) {
+            PVOID   buffer = NULL;
+            size_t  length = 0;
+
+            //
+            // WdfRequestRetrieveOutputBuffer returns both the buffer the
+            // request will receive into and how large it is, which is what
+            // bounds the copy.
+            //
+            if (NT_SUCCESS(WdfRequestRetrieveOutputBuffer(request,
+                                                           0,
+                                                           &buffer,
+                                                           &length)) &&
+                (buffer != NULL) && (length > 0)) {
+
+                RingBufferRead(&QueueContext->RingBuffer,
+                               (BYTE*) buffer,
+                               (available > length) ? length : available,
+                               &copied);
+            }
+        }
+
+        //
+        // copied == 0 is a legitimate outcome: it is how a read reports that
+        // its timeout expired with nothing to deliver.
+        //
+        WdfRequestCompleteWithInformation(request, STATUS_SUCCESS, (ULONG) copied);
+    }
+}
