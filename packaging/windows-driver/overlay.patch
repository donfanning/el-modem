+ULONG
+QueueGetReadTimeoutMs(
+    _In_ PQUEUE_CONTEXT QueueContext
+    )
+{
+    SERIAL_TIMEOUTS timeouts;
+    ULONGLONG       total;
+
+    GetTimeouts(QueueContext->DeviceContext, &timeouts);
+
+    //
+    // All fields MAXULONG is the documented way of saying "wait forever".
+    //
+    if ((timeouts.ReadIntervalTimeout        == MAXULONG) &&
+        (timeouts.ReadTotalTimeoutMultiplier == MAXULONG) &&
+        (timeouts.ReadTotalTimeoutConstant   == MAXULONG)) {
+        return INFINITE;
+    }
+
+    //
+    // For a read that has not yet returned any bytes the governing limit is
+    // the total; ReadIntervalTimeout only applies between bytes once a partial
+    // read is already under way, which this driver does not implement.
+    //
+    total = (ULONGLONG) timeouts.ReadTotalTimeoutMultiplier *
+            (ULONGLONG) timeouts.ReadTotalTimeoutConstant;
+
+    if (total > MAXULONG) {
+        return MAXULONG;
+    }
+
+    return (ULONG) total;
+}
