@@ -0,0 +1,537 @@
+/*++
+
+Copyright (c) El-Modem Project
+
+Module Name:
+
+    broker.c
+
+Abstract:
+
+    Pumps bytes between the driver's serial ring buffer and a named pipe.
+
+--*/
+
+#include "internal.h"
+#include "broker.h"
+
+#include <stdlib.h>
+#include <stdio.h>
+#include <string.h>
+#include <wchar.h>
+
+//
+// Minimal diagnostic sink. The WPP Trace() calls in this driver have no
+// collector attached, so broker failures were invisible. This writes the
+// Win32 error straight to a world-readable file so a failed connect can be
+// diagnosed without attaching a debugger to WUDFHost.
+//
+#define BROKER_LOG_PATH    "C:\\Users\\Public\\elmodem-broker.log"
+
+//
+// Append one already-formatted line to the diagnostic log.
+//
+static VOID
+BrokerLogLine(
+    _In_ PCSTR Line
+    )
+{
+    HANDLE  file;
+    DWORD   written = 0;
+
+    file = CreateFileA(BROKER_LOG_PATH,
+                       FILE_APPEND_DATA,
+                       FILE_SHARE_READ | FILE_SHARE_WRITE,
+                       NULL,
+                       OPEN_ALWAYS,
+                       FILE_ATTRIBUTE_NORMAL,
+                       NULL);
+
+    if (file == INVALID_HANDLE_VALUE) {
+        return;
+    }
+
+    WriteFile(file, Line, (DWORD) strlen(Line), &written, NULL);
+    CloseHandle(file);
+}
+
+VOID
+BrokerLogA(
+    _In_ PCSTR Message,
+    _In_ DWORD  Code
+    )
+{
+    CHAR    line[192];
+    int     n;
+
+    n = sprintf_s(line, sizeof(line), "%lu %s error=%lu\r\n",
+                  (unsigned long) GetTickCount(), Message, (unsigned long) Code);
+    if (n < 0) {
+        return;
+    }
+
+    BrokerLogLine(line);
+}
+
+#define BrokerLog(m, c) BrokerLogA((m), (c))
+
+//
+// Record which port and pipe a line is about. This earns its own sink: the log
+// is one file for every port on the machine, so with more than one installed
+// "which port is this line about" has to be answerable from the line itself.
+//
+static VOID
+BrokerLogPort(
+    _In_ PBROKER_CONTEXT Broker,
+    _In_ PCSTR           Message,
+    _In_ DWORD           Code
+    )
+{
+    CHAR    pipe[ELMODEM_PIPE_NAME_CCH * 2];
+    CHAR    port[ELMODEM_PORT_NAME_CCH * 2];
+    CHAR    line[sizeof(pipe) + sizeof(port) + 96];
+    int     n;
+
+    pipe[0] = '\0';
+    port[0] = '\0';
+
+    WideCharToMultiByte(CP_ACP, 0, Broker->PipeName, -1,
+                        pipe, sizeof(pipe), NULL, NULL);
+    WideCharToMultiByte(CP_ACP, 0, Broker->PortName, -1,
+                        port, sizeof(port), NULL, NULL);
+
+    n = sprintf_s(line, sizeof(line), "%lu pipe=%s port=%s %s error=%lu\r\n",
+                  (unsigned long) GetTickCount(),
+                  pipe,
+                  port,
+                  Message,
+                  (unsigned long) Code);
+    if (n < 0) {
+        return;
+    }
+
+    BrokerLogLine(line);
+}
+
+//
+// Read one REG_SZ out of a key the caller has already opened. Returns TRUE only
+// for a non-empty value that fits; anything else leaves the caller's fallback in
+// place. Failures are not logged here because "the value is absent" is the
+// normal case for both callers.
+//
+static BOOLEAN
+BrokerReadValue(
+    _In_  WDFKEY    Key,
+    _In_  PCWSTR    ValueName,
+    _Out_ PWCHAR    Value,
+    _In_  size_t    ValueCch
+    )
+{
+    UNICODE_STRING  name;
+    UNICODE_STRING  given;
+    WDFSTRING       string = NULL;
+    size_t          chars;
+    size_t          index;
+    NTSTATUS        status;
+
+    RtlInitUnicodeString(&name, ValueName);
+
+    status = WdfStringCreate(NULL, WDF_NO_OBJECT_ATTRIBUTES, &string);
+    if (!NT_SUCCESS(status)) {
+        return FALSE;
+    }
+
+    status = WdfRegistryQueryString(Key, &name, string);
+    if (NT_SUCCESS(status)) {
+        WdfStringGetUnicodeString(string, &given);
+        chars = given.Length / sizeof(WCHAR);
+        if ((chars > 0) && (chars < ValueCch)) {
+            for (index = 0; index < chars; index++) {
+                Value[index] = given.Buffer[index];
+            }
+            Value[chars] = L'\0';
+            WdfObjectDelete(string);
+            return TRUE;
+        }
+    }
+
+    WdfObjectDelete(string);
+    return FALSE;
+}
+
+VOID
+BrokerPump(
+    _In_ PBROKER_CONTEXT BrokerContext
+    );
+
+DWORD
+WINAPI
+BrokerThreadProc(
+    _In_ LPVOID Parameter
+    )
+{
+    PBROKER_CONTEXT broker = (PBROKER_CONTEXT) Parameter;
+    BYTE            buffer[BROKER_BUFFER_SIZE];
+    int             firstAttempt = 1;
+
+    BrokerLog("thread entered", 0);
+
+    while (InterlockedCompareExchange(&broker->Stop, 0, 0) == 0) {
+
+        if (firstAttempt) {
+            BrokerLog("first CreateFile attempt", 0);
+            firstAttempt = 0;
+        }
+
+        if (broker->Pipe == INVALID_HANDLE_VALUE) {
+
+            //
+            // El-Modem may not be running yet, or may have restarted. Retry
+            // quietly until it appears.
+            //
+            broker->Pipe = CreateFileW(broker->PipeName,
+                                       GENERIC_READ | GENERIC_WRITE,
+                                       0,
+                                       NULL,
+                                       OPEN_EXISTING,
+                                       0,
+                                       NULL);
+
+            if (broker->Pipe == INVALID_HANDLE_VALUE) {
+                BrokerLogPort(broker,
+                              "CreateFile failed",
+                              (DWORD) GetLastError());
+                Sleep(100);
+                continue;
+            }
+
+            BrokerLogPort(broker, "connected", 0);
+
+            Trace(TRACE_LEVEL_INFO, "Broker connected to El-Modem pipe");
+        }
+
+        //
+        // The ring is inbound only. Terminal output is sent straight to the
+        // pipe by BrokerSend() from EvtIoWrite; pulling from the ring here
+        // would immediately echo the modem's own data straight back to it,
+        // and the terminal would never see anything.
+        //
+
+        //
+        // Deliver anything El-Modem sent to the terminal. PeekNamedPipe keeps
+        // this non-blocking so the pump never stalls behind a slow reader.
+        //
+        {
+            DWORD  inPipe = 0;
+            DWORD  got = 0;
+            NTSTATUS status;
+
+            if (!PeekNamedPipe(broker->Pipe,
+                               NULL, 0, NULL, &inPipe, NULL)) {
+
+                //
+                // El-Modem closed its end. PeekNamedPipe is the first call that
+                // can observe a disconnect, so its failure must be handled here:
+                // if it were only guarded by the "any bytes?" test below, the
+                // pump would spin on a dead handle forever and never reconnect
+                // after El-Modem restarted.
+                //
+                BrokerLogPort(broker,
+                              "pipe disconnected",
+                              (DWORD) GetLastError());
+                CloseHandle(broker->Pipe);
+                broker->Pipe = INVALID_HANDLE_VALUE;
+                continue;
+            }
+
+            if (inPipe > 0) {
+
+                DWORD toRead = (inPipe > sizeof(buffer)) ?
+                                (DWORD) sizeof(buffer) : inPipe;
+
+                if (!ReadFile(broker->Pipe, buffer, toRead, &got, NULL)) {
+                    BrokerLog("pipe ReadFile failed", (DWORD) GetLastError());
+                    CloseHandle(broker->Pipe);
+                    broker->Pipe = INVALID_HANDLE_VALUE;
+                    continue;
+                }
+
+                BrokerLog("pipe->ring bytes", (DWORD) got);
+
+                if (got > 0) {
+                    status = RingBufferWrite(&broker->QueueContext->RingBuffer,
+                                             buffer,
+                                             got);
+                    if (!NT_SUCCESS(status)) {
+                        Trace(TRACE_LEVEL_ERROR,
+                            "Broker: RingBufferWrite failed 0x%x",
+                            status);
+                    }
+
+                    //
+                    // Data just arrived. Hand any parked read request
+                    // whatever is now buffered, otherwise the terminal stays
+                    // blocked until its read timeout expires.
+                    //
+                    QueueServicePendingReads(broker->QueueContext);
+                }
+            }
+        }
+
+        Sleep(BROKER_POLL_MS);
+    }
+
+    //
+    // Leaving the thread.
+    //
+    if (broker->Pipe != INVALID_HANDLE_VALUE) {
+        FlushFileBuffers(broker->Pipe);
+        CloseHandle(broker->Pipe);
+        broker->Pipe = INVALID_HANDLE_VALUE;
+    }
+
+    Trace(TRACE_LEVEL_INFO, "Broker thread exiting");
+    return 0;
+}
+
+
+NTSTATUS
+BrokerSend(
+    _In_ PQUEUE_CONTEXT QueueContext,
+    _In_reads_bytes_(Length) PVOID  Data,
+    _In_ size_t            Length
+    )
+{
+    PBROKER_CONTEXT broker = (PBROKER_CONTEXT) QueueContext->Broker;
+    DWORD           written = 0;
+    size_t          offset = 0;
+
+    if ((broker == NULL) || (broker->Pipe == INVALID_HANDLE_VALUE)) {
+        //
+        // No peer. Report success and let the caller fall back to the
+        // built-in AT responder.
+        //
+        return STATUS_SUCCESS;
+    }
+
+    while (offset < Length) {
+        if (!WriteFile(broker->Pipe,
+                       ((BYTE*) Data) + offset,
+                       (DWORD) (Length - offset),
+                       &written,
+                       NULL)) {
+            BrokerLogPort(broker,
+                          "BrokerSend failed",
+                          (DWORD) GetLastError());
+            CloseHandle(broker->Pipe);
+            broker->Pipe = INVALID_HANDLE_VALUE;
+            break;
+        }
+
+        if (written == 0) {
+            break;
+        }
+        offset += written;
+    }
+
+    return STATUS_SUCCESS;
+}
+
+
+//
+// Decide which pipe this port talks to.
+//
+// The port's own device key wins, which is what allows several ports to serve
+// several El-Modem instances at once. With no value set - every single-port
+// install - the default name is used and the port behaves exactly as it did
+// before this was configurable.
+//
+// This never fails the port. A key that cannot be read, or a value that is not
+// a name El-Modem could be listening on, keeps the default and says so in the
+// log: coming up on the default is recoverable, connecting to a name nobody
+// chose is not.
+//
+static VOID
+BrokerResolveIdentity(
+    _In_  WDFDEVICE Device,
+    _Out_ PWCHAR    Name,
+    _In_  size_t    NameCch,
+    _Out_ PWCHAR    Port,
+    _In_  size_t    PortCch
+    )
+{
+    static const WCHAR prefix[] = L"\\\\.\\pipe\\";
+    const size_t    prefixChars = (sizeof(prefix) / sizeof(prefix[0])) - 1;
+    const size_t    maxChars = ELMODEM_PIPE_NAME_CCH - 1 - prefixChars;
+    WDFKEY          key = NULL;
+    WCHAR           buffer[ELMODEM_PIPE_NAME_CCH];
+    size_t          chars;
+    size_t          index;
+    NTSTATUS        status;
+
+    wcsncpy_s(Name, NameCch, ELMODEM_PIPE_DEFAULT, _TRUNCATE);
+    wcsncpy_s(Port, PortCch, L"?", _TRUNCATE);
+
+    //
+    // PLUGPLAY_REGKEY_DEVICE already lands on the device's "Device Parameters"
+    // key, which is where the Ports class installer puts PortName - the sample
+    // reads it exactly this way - and so also where a per-port pipe name
+    // belongs. Measured, not assumed: opening a subkey called "Device
+    // Parameters" beneath this one answers STATUS_OBJECT_NAME_NOT_FOUND.
+    //
+    status = WdfDeviceOpenRegistryKey(Device,
+                                      PLUGPLAY_REGKEY_DEVICE,
+                                      KEY_QUERY_VALUE,
+                                      WDF_NO_OBJECT_ATTRIBUTES,
+                                      &key);
+    if (!NT_SUCCESS(status)) {
+        BrokerLog("identity: device key unreadable", (DWORD) status);
+        return;
+    }
+
+    //
+    // The port number is read for the log only. Windows owns this value; the
+    // driver never writes it.
+    //
+    BrokerReadValue(key, L"PortName", Port, PortCch);
+
+    if (!BrokerReadValue(key,
+                         ELMODEM_PIPE_VALUE,
+                         buffer,
+                         ELMODEM_PIPE_NAME_CCH)) {
+        //
+        // No override on this port. That is the normal single-port case, so it
+        // is not a fault; the resolved identity is logged either way.
+        //
+        WdfRegistryClose(key);
+        return;
+    }
+
+    WdfRegistryClose(key);
+
+    chars = wcslen(buffer);
+
+    if (chars > maxChars) {
+        BrokerLog("identity: override too long for a pipe name", 0);
+        return;
+    }
+
+    if ((chars > prefixChars) && (_wcsnicmp(buffer, prefix, prefixChars) == 0)) {
+        //
+        // Already a full pipe path.
+        //
+        wcsncpy_s(Name, NameCch, buffer, _TRUNCATE);
+        return;
+    }
+
+    if (wcschr(buffer, L'\\') == NULL) {
+        //
+        // A bare name, exactly as --serial-device accepts it.
+        //
+        for (index = 0; index < prefixChars; index++) {
+            Name[index] = prefix[index];
+        }
+        for (index = 0; index < chars; index++) {
+            Name[prefixChars + index] = buffer[index];
+        }
+        Name[prefixChars + chars] = L'\0';
+        return;
+    }
+
+    BrokerLog("identity: override is neither a name nor a pipe path", 0);
+    wcsncpy_s(Name, NameCch, ELMODEM_PIPE_DEFAULT, _TRUNCATE);
+}
+
+
+PBROKER_CONTEXT
+BrokerStart(
+    _In_ PQUEUE_CONTEXT QueueContext
+    )
+{
+    PBROKER_CONTEXT broker;
+
+    broker = (PBROKER_CONTEXT) calloc(1, sizeof(BROKER_CONTEXT));
+    if (broker == NULL) {
+        return NULL;
+    }
+
+    broker->QueueContext = QueueContext;
+    broker->Stop = 0;
+    broker->Pipe = INVALID_HANDLE_VALUE;
+
+    //
+    // Settle the pipe and port names before the pump starts using them.
+    //
+    BrokerResolveIdentity(QueueContext->DeviceContext->Device,
+                          broker->PipeName,
+                          ELMODEM_PIPE_NAME_CCH,
+                          broker->PortName,
+                          ELMODEM_PORT_NAME_CCH);
+    BrokerLogPort(broker, "identity", 0);
+
+    //
+    // NOTE: the 5th parameter of CreateThread is dwCreationFlags, NOT a
+    // priority. An earlier revision passed THREAD_PRIORITY_BELOW_NORMAL here;
+    // that constant is -1, so it became a bogus 0xFFFFFFFF creation flag and
+    // CreateThread returned a handle whose thread never actually ran. Priority
+    // must be set separately with SetThreadPriority.
+    //
+    broker->Thread = CreateThread(NULL,
+                                  0,
+                                  BrokerThreadProc,
+                                  broker,
+                                  0,
+                                  NULL);
+
+    if (broker->Thread == NULL) {
+        Trace(TRACE_LEVEL_ERROR,
+            "Broker: CreateThread failed %d", GetLastError());
+        free(broker);
+        return NULL;
+    }
+
+    //
+    // Keep the pump out of the terminal's way: its read latency matters far
+    // more than the broker's, and the pump must never starve serial callbacks.
+    //
+    SetThreadPriority(broker->Thread, THREAD_PRIORITY_BELOW_NORMAL);
+
+    QueueContext->Broker = broker;
+
+    BrokerLog("pump started", 0);
+    Trace(TRACE_LEVEL_INFO, "Broker pump started");
+    return broker;
+}
+
+
+VOID
+BrokerStop(
+    _In_opt_ PBROKER_CONTEXT BrokerContext
+    )
+{
+    if (BrokerContext == NULL) {
+        return;
+    }
+
+    InterlockedExchange(&BrokerContext->Stop, 1);
+
+    if (BrokerContext->Thread != NULL) {
+        WaitForSingleObject(BrokerContext->Thread, 2000);
+        CloseHandle(BrokerContext->Thread);
+        BrokerContext->Thread = NULL;
+    }
+
+    free(BrokerContext);
+}
+
+
+BOOLEAN
+BrokerIsConnected(
+    _In_opt_ PBROKER_CONTEXT BrokerContext
+    )
+{
+    if ((BrokerContext == NULL) || (BrokerContext->Pipe == INVALID_HANDLE_VALUE)) {
+        return FALSE;
+    }
+    return TRUE;
+}
